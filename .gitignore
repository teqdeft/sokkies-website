# Lokale WordPress-config (geheimen + lokale DB-gegevens) — zie wp-config.example.php
sokkies-local/wp-config.php

# Media-uploads = content, geen code (gaat via aparte sync naar de server)
sokkies-local/wp-content/uploads/

# Logs & systeembestanden
*.log
sokkies-local/wp-content/debug.log
.DS_Store
Thumbs.db
.dropbox*

# Database-exports (Gravity Forms e.d.) — bevatten interne e-mailadressen en
# horen niet publiek op de server te staan; ze gaan handmatig naar live.
exports/

# Lokale hulpplugins — horen niet in de repo (en dus niet op de server)
sokkies-local/wp-content/plugins/wp-migrate-db/
# Gravity Forms: live heeft een eigen installatie die niet uit deze repo komt.
# Meecommitten zou die via de FTPS-deploy overschrijven (circa 24 MB).
sokkies-local/wp-content/plugins/gravityforms/
sokkies-local/wp-content/mu-plugins/
